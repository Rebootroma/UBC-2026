# Copy to .env.local and fill in. NEVER commit .env.local. Use testnet-only keys.
ADMIN_PRIVATE_KEY=0x...
ORACLE_PRIVATE_KEY=0x...
ATTACKER_PRIVATE_KEY=0x...
ARC_RPC_URL=https://rpc.testnet.arc.network
# Optional: enables LLM agents (otherwise deterministic fact summaries)
ANTHROPIC_API_KEY=
# or a free-tier Google Gemini key (used when no Anthropic key is set)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# AGENTS_MODE=deterministic
# Let the attack console broadcast real (reverting) transactions
ALLOW_BROADCAST_ATTACKS=true
# Optional: security token of the QuickNode Stream that posts to /api/stream
QUICKNODE_STREAM_TOKEN=

# Optional: spoken settlement briefings (ElevenLabs text-to-speech)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
